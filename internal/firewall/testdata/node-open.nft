# Termit firewall: the table `termit-uv firewall on` applied. Do not edit by hand.
# `termit-uv firewall off` removes it and leaves the host as it was.
destroy table inet termit_uv

table inet termit_uv {
	set blocked4 {
		type ipv4_addr
		flags interval
		auto-merge
	}

	set blocked6 {
		type ipv6_addr
		flags interval
		auto-merge
	}

	set banned4 {
		type ipv4_addr
		flags timeout
	}

	set banned6 {
		type ipv6_addr
		flags timeout
	}

	set scan4 {
		type ipv4_addr
		flags dynamic, timeout
		timeout 15m
	}

	set scan6 {
		type ipv6_addr
		flags dynamic, timeout
		timeout 15m
	}

	chain input {
		type filter hook input priority -5; policy accept;

		# Loopback and connections that already carry traffic are never a decision.
		iif lo accept
		ct state established,related accept
		ct state invalid drop

		# The public list first, then what the guard banned. Both are sets the tools maintain.
		ip saddr @blocked4 drop
		ip6 saddr @blocked6 drop
		ip saddr @banned4 drop
		ip6 saddr @banned6 drop

		# ICMPv6 is not optional for IPv6: without NDP and PMTU messages the family dies.
		icmpv6 type { nd-router-solicit, nd-router-advert, nd-neighbor-solicit,
		              nd-neighbor-advert, packet-too-big, destination-unreachable,
		              time-exceeded } accept

		# The ports this host publishes.
		tcp dport { 22, 80, 443 } accept

		# Everything else is counted per source in the kernel. The meter's own set is the rate
		# state; the add remembers the offender for the guard, which decides the ban.
		meter scan4m { ip saddr limit rate over 5/minute } add @scan4 { ip saddr timeout 15m }
		meter scan6m { ip6 saddr limit rate over 5/minute } add @scan6 { ip6 saddr timeout 15m }
	}
}
